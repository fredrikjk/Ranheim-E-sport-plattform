# Copy to .env or .env.local. Never commit real secrets.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLUB_NAME=Ranheim E-sport

# --- Database (EU region in production) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ranheim

# --- Auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=ranheim_session
OTP_PROVIDER=dev

# Production SMS provider (do not set OTP_PROVIDER=dev in production)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Twitch (server-side only, never NEXT_PUBLIC_*) ---
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_EVENTSUB_SECRET=

# --- Cloudflare / R2 (later) ---
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
